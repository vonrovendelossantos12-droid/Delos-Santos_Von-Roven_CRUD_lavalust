# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
MIGRATIONS_ENABLED=true

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
